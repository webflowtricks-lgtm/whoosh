{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naruto-infinity-beta",
  "main": "workers/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "LEGACY_API_ORIGIN": "https://narutoarena.onrender.com"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDurableObject" },
      { "name": "MATCH_ROOM", "class_name": "MatchRoomDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchmakerDurableObject", "MatchRoomDurableObject"] }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  }
}
