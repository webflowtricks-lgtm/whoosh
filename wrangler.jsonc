{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naruto-infinity-beta",
  "main": "workers/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "secret-sunrise-pgtt6"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDurableObject" },
      { "name": "MATCH_ROOM", "class_name": "MatchRoomDurableObject" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naruto-infinity-beta",
      "database_id": "02cef23b-de7c-428c-94f0-811b9064f512",
      "migrations_dir": "migrations/d1"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchmakerDurableObject", "MatchRoomDurableObject"] }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  }
}
